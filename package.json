{
  "name": "lms-widget-manager",
  "version": "1.1.0",
  "description": "Connects embedded editors and widgets to LMS answer boxes, such as Moodle quiz essay questions: saves, autosaves, review modes and set-up checks.",
  "keywords": [
    "lms",
    "moodle",
    "moodle-quiz",
    "essay-question",
    "widget",
    "postmessage",
    "iframe",
    "web-components"
  ],
  "author": "PWL",
  "license": "MIT",
  "homepage": "https://github.com/pypad-dev/lms-widget-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pypad-dev/lms-widget-manager.git"
  },
  "bugs": {
    "url": "https://github.com/pypad-dev/lms-widget-manager/issues"
  },
  "main": "dist/lms-widget-manager.cjs.js",
  "module": "dist/lms-widget-manager.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
